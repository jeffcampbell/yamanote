# Yamanote configuration — copy to .env and uncomment what you need.
# Real environment variables win over this file; ~/development/.env is also read,
# so keys kept there work too. Defaults are shown.

# ── Required ────────────────────────────────────────────────────────────────
# OpenRouter key for all agent work (set a spending limit on the key itself, too)
# OPENROUTER_API_KEY=sk-or-...

# Parent directory of your project(s); projects must be git repos inside it
# AGENT_TEAM_DEV_DIR=~/development
# Default project (directory name under AGENT_TEAM_DEV_DIR). Ignored when projects.json exists.
# AGENT_TEAM_DEFAULT_PROJECT=my-app

# ── Jev (via `decide`) for cheap decisions — optional ───────────────────────
# Without it, LLM agents make those calls instead (slower, more tokens).
# TYPESAFE_API_KEY=...
# YAMANOTE_DECIDE_SRC=~/development/decide/src
# YAMANOTE_DECIDE=1                 # 0 = never use decide
# DECIDE_BACKEND=jev                # or "ollama" to keep code on this machine (per project: projects.json)

# ── Capacity & budget ───────────────────────────────────────────────────────
# AGENT_TEAM_MAX_TRAINS=1           # trains between Build and Deploy at once (old *_TRAINS counts are summed if unset)
# AGENT_TEAM_MAX_PLANNING_JOBS=2    # concurrent triage/spec jobs
# AGENT_TEAM_DAILY_BUDGET_USD=20    # new departures stop once today's spend reaches this
# AGENT_TEAM_ITEM_BUDGET_USD=4      # hard cap per train (retrospectives excepted)
# AGENT_TEAM_RUN_BUDGET_USD=2       # cap per agent run
# AGENT_TEAM_MAX_RUNS_PER_HOUR=60   # "fare limit"

# ── Autopilot (seeds the dashboard's Settings panel; once saved there, the panel wins)
# AGENT_TEAM_AUTOPILOT=0                       # start in autopilot ("dark") on first run
# AGENT_TEAM_AUTOPILOT_ON_CRON="0 22 * * *"    # switch autopilot on (local time)
# AGENT_TEAM_AUTOPILOT_OFF_CRON="0 7 * * 1-5"  # switch it off
# AGENT_TEAM_AUTOPILOT_MERGE_WITHOUT_TESTS=0   # 1 = autopilot may merge projects with no test command

# ── Supervised gates & quality bar (per-project gates go in projects.json) ──
# AGENT_TEAM_GATE_SPEC=0            # 1 = approve each spec before Build (seeds Settings)
# AGENT_TEAM_GATE_MERGE=0           # 1 = approve each merge to trunk (seeds Settings)
# AGENT_TEAM_SATISFACTION=1.0       # fraction of (non-disputed) holdout scenarios that must pass

# ── Checks (single-project defaults; per-project "setup"/"test" go in projects.json)
# AGENT_TEAM_SETUP_CMD=npm ci       # once per worktree: install git-ignored dependencies
# AGENT_TEAM_TEST_CMD=npm test      # after every build and in the merge queue
# AGENT_TEAM_SETUP_TIMEOUT=900
# AGENT_TEAM_TEST_TIMEOUT=600

# ── Learning ────────────────────────────────────────────────────────────────
# AGENT_TEAM_RETRO=1                # JY09 retrospective after every journey (writes the station playbooks)
# AGENT_TEAM_ADAPTIVE_ROUTING=0     # 1 = let first-pass history and class-fit votes move difficulty→class

# ── Deploy, monitoring & safety nets ────────────────────────────────────────
# AGENT_TEAM_TRUNK_BRANCH=main
# AGENT_TEAM_SERVICE_RESTART_CMD=sudo systemctl restart my-app.service
# AGENT_TEAM_APP_LOG_GLOB=logs/*.log   # app log(s) Signal tails, relative to the project
# AGENT_TEAM_DEPLOY_WATCH_SECONDS=900  # watch logs this long after each deploy (0 = off)
# AGENT_TEAM_AUTO_REVERT=0             # 1 = revert a merge when a post-deploy regression appears
# Railway (alternative to SERVICE_RESTART_CMD): staging first, then production
# AGENT_TEAM_RAILWAY_PROJECT=my-railway-project
# AGENT_TEAM_RAILWAY_STAGING_ENV=staging
# AGENT_TEAM_RAILWAY_PRODUCTION_ENV=production

# ── Notifications (hooks; see README "Notifications") ───────────────────────
# AGENT_TEAM_NOTIFY_CMD='your-signal-cli send "$YAMANOTE_TITLE: $YAMANOTE_MESSAGE $YAMANOTE_URL"'
# AGENT_TEAM_NOTIFY_WEBHOOK=https://example.com/hooks/yamanote
# AGENT_TEAM_NOTIFY_EVENTS=gate,failed,suspended,regression,reverted,stalled,autopilot   # also: done
# AGENT_TEAM_PUBLIC_URL=http://raspi-5.local:8080    # dashboard URL for links in notifications

# ── Dashboard ───────────────────────────────────────────────────────────────
# AGENT_TEAM_DASHBOARD_PORT=0           # e.g. 8080; 0 = off (or pass --dashboard / --dashboard-port)
# AGENT_TEAM_DASHBOARD_HOST=127.0.0.1   # 0.0.0.0 to reach it from other devices ...
# AGENT_TEAM_DASHBOARD_TOKEN=           # ... and then set this: required for every API read and action

# ── Pacing & limits ─────────────────────────────────────────────────────────
# AGENT_TEAM_TICK_SECONDS=3             # orchestrator loop interval
# AGENT_TEAM_DISPATCHER_INTERVAL=1800   # seconds between Dispatcher surveys
# AGENT_TEAM_OPS_INTERVAL=3600          # seconds between Ops digests
# AGENT_TEAM_AGENT_TIMEOUT_SECONDS=1200 # wall-clock limit per agent run
# AGENT_TEAM_AGENT_MAX_STEPS=60         # model turns per agent run
# AGENT_TEAM_ITEM_SLA_SECONDS=10800     # a train on the line longer than this is failed

# ── Advanced ────────────────────────────────────────────────────────────────
# YAMANOTE_DATA_DIR=./agents            # database, pause file, PID lock
# YAMANOTE_FALLBACK_MODEL=openrouter/auto   # fallback when a station's model errors
# OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions   # any OpenAI-compatible endpoint
